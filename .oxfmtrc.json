{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "sortTailwindcss": {
    "functions": ["clsx", "cn", "cva"],
    "stylesheet": "./src/app/globals.css"
  },
  "ignorePatterns": [
    "pnpm-lock.yaml",
    "skills-lock.json",
    "public/**",
    "src/__registry__/**",
    "src/content/**",
    ".agents/**",
    ".cursor/**",
    "AGENTS.md",
    "CLAUDE.md"
  ]
}
